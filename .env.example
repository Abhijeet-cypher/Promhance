# LLM provider (Vercel AI SDK + DeepSeek) — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key
# Optional overrides (defaults shown):
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_THINKING=disabled   # set to "enabled" to turn reasoning back on

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin dashboard access — comma-separated list of admin account emails.
# Only signed-in users whose email matches one of these can open /admin.
# Example: ADMIN_EMAILS=you@example.com,teammate@example.com
ADMIN_EMAILS=

# Optional: shared rate limiting across serverless instances (recommended in
# production). Without these, limits are per-instance and best-effort.
# Upstash Redis — REST API credentials
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: search engine ownership verification tokens (content values only).
# Google Search Console → HTML tag; Bing Webmaster Tools → msvalidate.01 meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
