# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: shared rate limiting across serverless instances (recommended in
# production). Without these, limits are per-instance and best-effort.
# Upstash Redis — REST API credentials
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: search engine ownership verification tokens (content values only).
# Google Search Console → HTML tag; Bing Webmaster Tools → msvalidate.01 meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
